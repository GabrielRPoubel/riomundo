---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tempoLeitura, formatarData, visivel } from '../data/site';

// Cards de "Nossa opinião" vêm dos arquivos src/content/colunas/*.md
// (criados pelo editor.html). Os mais recentes aparecem primeiro.
// Suspenso em suspensos.json não aparece (gerir.html).
const selecao = (await getCollection('colunas'))
  .filter(visivel)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((entry) => ({
    href: `/coluna/${entry.slug}`,
    imagem: entry.data.imagem,
    genero: entry.data.genero,
    title: entry.data.title,
    excerpt: entry.data.excerpt,
    editoria: entry.data.editoria,
    author: entry.data.author,
    date: formatarData(entry.data.pubDate),
    readTime: tempoLeitura(entry.body),
  }));

const [destaque, ...restante] = selecao;

// "Em voga" e "Últimas atualizações" derivam dos artigos reais — sem posts falsos.
// "Em voga" pula o destaque para a capa não repetir o mesmo texto 3 vezes.
const emVoga = (selecao.length > 1 ? selecao.slice(1, 4) : selecao.slice(0, 3));
const ultimas = selecao.slice(0, 4);
---

<Base>
  <h1 class="sr-only">Rio Mundo — Notícias sobre o Rio e o mundo pela ótica de uma esquerda não identitária</h1>

  <!-- A SELEÇÃO -->
  <section id="selecao" aria-labelledby="titulo-selecao" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-10 md:py-12">
    <div class="flex items-baseline gap-4 border-b-2 border-verde-950 pb-3">
      <h2 id="titulo-selecao" class="font-display shrink-0 text-3xl font-semibold tracking-tight md:text-4xl">Nossa opinião</h2>
      <span class="hidden h-px flex-1 bg-verde-950/15 md:block" aria-hidden="true"></span>
      <span class="hidden shrink-0 text-xs font-bold uppercase tracking-widest text-verde-950/70 sm:block">{selecao.length} texto{selecao.length === 1 ? '' : 's'}</span>
    </div>

    {destaque && (
      destaque.imagem ? (
        <article class="group mt-8 grid gap-8 border-b border-verde-950/10 pb-10 md:grid-cols-2 md:items-center">
          <a href={destaque.href} class="block overflow-hidden border border-verde-950/15 bg-white" tabindex="-1" aria-hidden="true">
            <img src={destaque.imagem} alt="" loading="eager" decoding="async" class="aspect-[16/9] w-full object-cover" />
          </a>
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">{destaque.genero}</p>
            <h3 class="font-display mt-2 text-4xl font-semibold leading-[1.02] tracking-tight md:text-5xl">
              <a href={destaque.href} class="group-hover:underline group-hover:decoration-verde-800 group-hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{destaque.title}</a>
            </h3>
            <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-verde-950/75">{destaque.excerpt}</p>
            <p class="mt-4 border-t border-verde-950/10 pt-3 text-xs text-verde-950/75">
              <span class="font-bold uppercase tracking-widest text-verde-950/70">{destaque.editoria}</span>
              <span class="mx-1" aria-hidden="true">•</span> {destaque.author} <span class="mx-1" aria-hidden="true">•</span> {destaque.date} <span class="mx-1" aria-hidden="true">•</span> {destaque.readTime}
            </p>
          </div>
        </article>
      ) : (
        <article class="group mt-8 max-w-3xl border-b border-verde-950/10 pb-10">
          <p class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">
            <span class="inline-block h-px w-8 bg-verde-900" aria-hidden="true"></span>
            {destaque.genero} — Destaque
          </p>
          <h3 class="font-display mt-3 text-4xl font-semibold leading-[1.02] tracking-tight text-verde-950 md:text-[3.25rem]">
            <a href={destaque.href} class="group-hover:underline group-hover:decoration-verde-800 group-hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{destaque.title}</a>
          </h3>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-verde-950/75 md:text-lg">{destaque.excerpt}</p>
          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-verde-950/10 pt-4 text-xs text-verde-950/75">
            <span class="font-bold uppercase tracking-widest text-verde-950/70">{destaque.editoria}</span>
            <span aria-hidden="true">•</span> <span>{destaque.author}</span>
            <span aria-hidden="true">•</span> <span>{destaque.date}</span>
            <span aria-hidden="true">•</span> <span>{destaque.readTime}</span>
            <a href={destaque.href} class="ml-auto hidden text-xs font-bold uppercase tracking-widest text-verde-900 underline underline-offset-4 hover:text-verde-800 sm:inline">Ler artigo →</a>
          </p>
        </article>
      )
    )}

    <div class="mt-8 grid gap-x-8 gap-y-10 md:grid-cols-3">
      {restante.map((c) => (
        <article class="group flex flex-col border-t-2 border-verde-950/80 pt-4">
          {c.imagem && (<img src={c.imagem} alt="" loading="lazy" decoding="async" class="mb-4 aspect-[16/10] w-full border border-verde-950/15 object-cover" />)}
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">{c.genero}</p>
          <h3 class="font-display mt-2 text-2xl font-semibold leading-tight"><a href={c.href} class="group-hover:underline group-hover:decoration-verde-800 group-hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{c.title}</a></h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-verde-950/75">{c.excerpt}</p>
          <p class="mt-4 border-t border-verde-950/10 pt-3 text-xs text-verde-950/75">
            <span class="font-bold uppercase tracking-widest text-verde-950/70">{c.editoria}</span>
            <span class="mx-1" aria-hidden="true">•</span> {c.author} <span class="mx-1" aria-hidden="true">•</span> {c.date} <span class="mx-1" aria-hidden="true">•</span> {c.readTime}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- MAIS LIDAS — deriva dos artigos reais -->
  <section id="mais-lidas" aria-labelledby="titulo-voga" class="scroll-mt-24 border-y border-verde-950/15 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="flex items-baseline gap-4 border-b-2 border-verde-950 pb-3">
        <h2 id="titulo-voga" class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Em voga</h2>
      </div>
      <ol class="mt-2 grid gap-8 md:grid-cols-3">
        {emVoga.map((o, i) => (
          <li class="flex gap-5 border-b border-verde-950/10 py-6 md:border-b-0">
            <span class="font-display text-6xl font-semibold leading-none text-verde-800" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">{o.genero}</p>
              <h3 class="font-display mt-2 text-xl font-semibold leading-snug"><a href={o.href} class="hover:underline hover:decoration-verde-800 hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{o.title}</a></h3>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PODCASTS — filler honesto até o EP 01 -->
  <section id="podcasts" aria-labelledby="titulo-podcasts" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-12">
    <div class="flex items-baseline gap-4 border-b-2 border-verde-950 pb-3">
      <h2 id="titulo-podcasts" class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Podcasts</h2>
      <span class="hidden h-px flex-1 bg-verde-950/15 md:block" aria-hidden="true"></span>
      <span class="shrink-0 rounded-full border border-verde-900/30 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">Em breve</span>
    </div>
    <article class="mt-8 grid gap-8 border border-dashed border-verde-950/25 bg-white p-8 md:grid-cols-[auto_1fr_auto] md:items-center md:p-10">
      <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-verde-950 text-marfim-100" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke-linecap="round" /></svg>
      </span>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">Podcast • gravando</p>
        <h3 class="font-display mt-2 text-2xl font-semibold leading-tight md:text-3xl">O primeiro episódio já está saindo do forno</h3>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-verde-950/65">Assim que ficar pronto, aparece aqui para ouvir e baixar. Por enquanto, a conversa segue no X.</p>
      </div>
      <a href="https://x.com/rionomundo" target="_blank" rel="noreferrer" class="inline-block min-h-[44px] shrink-0 bg-verde-950 px-6 py-3 text-xs font-bold uppercase tracking-widest text-marfim-100 hover:bg-verde-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verde-900">Acompanhar no X →</a>
    </article>
  </section>

  <!-- ENTREVISTAS — filler honesto até a primeira conversa -->
  <section id="entrevistas" aria-labelledby="titulo-entrevistas" class="scroll-mt-24 border-y border-verde-950/15 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="flex items-baseline gap-4 border-b-2 border-verde-950 pb-3">
        <h2 id="titulo-entrevistas" class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Entrevistas</h2>
        <span class="hidden h-px flex-1 bg-verde-950/15 md:block" aria-hidden="true"></span>
        <span class="shrink-0 rounded-full border border-verde-900/30 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">Em breve</span>
      </div>
      <article class="mt-8 grid gap-0 overflow-hidden border border-dashed border-verde-950/25 bg-marfim-100 md:grid-cols-2">
        <div class="grid min-h-[220px] place-items-center bg-verde-950 p-10 text-center text-marfim-100">
          <div>
            <span class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-white/25" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <p class="mt-4 text-xs font-bold uppercase tracking-[0.25em] text-verde-300">Conversas longas</p>
            <p class="font-display mt-2 text-xl font-semibold">A primeira ainda está no forno</p>
          </div>
        </div>
        <div class="flex flex-col justify-center p-8 md:p-10">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">Vídeo • YouTube</p>
          <h3 class="font-display mt-2 text-2xl font-semibold leading-tight">Boa conversa leva tempo</h3>
          <p class="mt-2 text-sm leading-relaxed text-verde-950/65">Estamos marcando e gravando. Quando sair, avisamos no X.</p>
          <a href="https://x.com/rionomundo" target="_blank" rel="noreferrer" class="mt-5 inline-block self-start text-xs font-bold uppercase tracking-widest text-verde-900 underline underline-offset-4 hover:text-verde-800 focus-visible:outline-2 focus-visible:outline-verde-900">Ver no X →</a>
        </div>
      </article>
    </div>
  </section>

  <!-- EM CONTÍNUO + NEWSLETTER -->
  <section id="em-continuo" aria-labelledby="titulo-continuo" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-12">
    <div class="grid gap-12 md:grid-cols-[1fr_1fr]">
      <div>
        <div class="flex items-baseline gap-4 border-b-2 border-verde-950 pb-3">
          <h2 id="titulo-continuo" class="font-display text-3xl font-semibold tracking-tight">Últimas atualizações</h2>
        </div>
        <ul class="mt-2">
          {ultimas.map((e) => (
            <li class="flex gap-4 border-b border-verde-950/10 py-4">
              <span class="flex flex-col items-center" aria-hidden="true">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-verde-800"></span>
                <span class="w-px flex-1 bg-verde-950/10"></span>
              </span>
              <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">{e.date}</p>
                <a href={e.href} class="font-display mt-1 block text-lg font-medium leading-snug hover:underline hover:decoration-verde-800 hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{e.title}</a>
              </div>
            </li>
          ))}
        </ul>
        <a href="https://x.com/rionomundo" target="_blank" rel="noreferrer" class="mt-5 inline-block text-sm font-bold uppercase tracking-widest text-verde-900 underline underline-offset-4 hover:text-verde-800 focus-visible:outline-2 focus-visible:outline-verde-900">
          Toda a atualidade no X →
        </a>
      </div>

      <div id="newsletter" class="flex flex-col justify-center bg-verde-950 p-6 text-center text-marfim-100 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-verde-300">Newsletter</p>
        <p class="mx-auto mt-3 inline-block rounded-full border border-white/25 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-marfim-100">Em breve</p>
        <h2 class="font-display mt-3 text-3xl font-semibold leading-tight md:text-4xl">O essencial no seu e-mail</h2>
        <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-marfim-200/75">Ainda estamos montando. Por enquanto, lê por aqui e acompanha no X.</p>
        <a href="https://x.com/rionomundo" target="_blank" rel="noreferrer" class="mx-auto mt-6 inline-block min-h-[44px] bg-marfim-100 px-6 py-3 text-xs font-bold uppercase tracking-widest text-verde-950 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Acompanhar no X →</a>
        <p class="mt-4 text-[11px] text-marfim-200/70">Sem pressa, sem spam.</p>
      </div>
    </div>
  </section>
</Base>
