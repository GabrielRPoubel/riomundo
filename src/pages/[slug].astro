---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { tempoLeitura, formatarData, visivel, url, paginaUrl } from '../data/site';

export async function getStaticPaths() {
  const colunas = (await getCollection('colunas')).filter(visivel);
  return colunas.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = formatarData(entry.data.pubDate);
const readTime = tempoLeitura(entry.body);

// "Leia também": mesma editoria primeiro, completa com os mais recentes.
const todos = (await getCollection('colunas')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const mesmos = todos.filter((e) => e.slug !== entry.slug && e.data.editoria === entry.data.editoria);
const outros = todos.filter((e) => e.slug !== entry.slug && e.data.editoria !== entry.data.editoria);
const leiaTambem = [...mesmos, ...outros].slice(0, 2);

// Compartilhar sem JS: links de intenção do X e do WhatsApp (URL curta e viva).
const pagina = paginaUrl(entry.slug);
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(pagina)}`;
const shareZap = `https://wa.me/?text=${encodeURIComponent(`${entry.data.title} — ${pagina}`)}`;
---

<Base title={`${entry.data.title} — Rio Mundo`} description={entry.data.excerpt} image={entry.data.imagem ?? '/logo-polido.png'} type="article" pubDate={entry.data.pubDate.toISOString()}>
  <article class="mx-auto max-w-[65ch] scroll-mt-24 px-6 pb-16 pt-10 md:pt-14">
    <a href={url('#selecao')} class="text-xs font-bold uppercase tracking-[0.2em] text-verde-900 hover:underline focus-visible:outline-2 focus-visible:outline-verde-900">← Voltar</a>
    <p class="mt-6 text-xs font-bold uppercase tracking-[0.25em] text-verde-900">
      {entry.data.genero}
    </p>
    <h1 class="font-display mt-4 text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 border-b-2 border-verde-950 pb-5 text-lg leading-relaxed text-verde-950/75">{entry.data.excerpt}</p>
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-verde-950/75">
      Por {entry.data.author} <span class="mx-1">•</span> {data} <span class="mx-1">•</span> {readTime} de leitura
    </p>
    <p class="mt-3 flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.18em] text-verde-950/70">
      <span>Compartilhar:</span>
      <a href={shareX} target="_blank" rel="noreferrer" aria-label="Compartilhar no X" class="grid h-9 w-9 place-items-center rounded-full border border-verde-900/30 text-verde-900 transition hover:bg-verde-950 hover:text-marfim-100 focus-visible:outline-2 focus-visible:outline-verde-900">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
      </a>
      <a href={shareZap} target="_blank" rel="noreferrer" aria-label="Compartilhar no WhatsApp" class="grid h-9 w-9 place-items-center rounded-full border border-verde-900/30 text-verde-900 transition hover:bg-verde-950 hover:text-marfim-100 focus-visible:outline-2 focus-visible:outline-verde-900">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      </a>
    </p>
    {entry.data.imagem && (
      <figure class="mt-6">
        <img src={entry.data.imagem} alt="" class="aspect-video w-full border border-verde-950/15 object-cover" />
      </figure>
    )}
    <div class="prose-jornal mt-8">
      <Content />
    </div>
    {leiaTambem.length > 0 && (
      <section aria-labelledby="titulo-leia" class="mt-12 border-t-2 border-verde-950 pt-6">
        <h2 id="titulo-leia" class="font-display text-2xl font-semibold tracking-tight">Leia também</h2>
        <ul class="mt-4 grid gap-6 sm:grid-cols-2">
          {leiaTambem.map((r) => (
            <li class="border-t border-verde-950/15 pt-3">
              <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-verde-900">{r.data.genero}</p>
              <a href={url(r.slug)} class="font-display mt-1 block text-lg font-semibold leading-snug hover:underline hover:decoration-verde-800 hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-verde-900">{r.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-verde-950/15 pt-6">
      <a href="https://x.com/rionomundo" target="_blank" rel="noreferrer" class="text-sm font-bold uppercase tracking-widest text-verde-900 underline underline-offset-4 hover:text-verde-800 focus-visible:outline-2 focus-visible:outline-verde-900">
        Comente no @rionomundo →
      </a>
      <span class="ml-auto flex items-center gap-3 text-xs font-bold uppercase tracking-widest">
        <span class="text-verde-950/70">Compartilhar:</span>
        <a href={shareX} target="_blank" rel="noreferrer" aria-label="Compartilhar no X" class="grid h-9 w-9 place-items-center rounded-full border border-verde-900/30 text-verde-900 transition hover:bg-verde-950 hover:text-marfim-100 focus-visible:outline-2 focus-visible:outline-verde-900">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
        </a>
        <a href={shareZap} target="_blank" rel="noreferrer" aria-label="Compartilhar no WhatsApp" class="grid h-9 w-9 place-items-center rounded-full border border-verde-900/30 text-verde-900 transition hover:bg-verde-950 hover:text-marfim-100 focus-visible:outline-2 focus-visible:outline-verde-900">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        </a>
      </span>
    </div>
  </article>
</Base>

<style>
  .prose-jornal {
    font-size: 17px;
  }
  .prose-jornal :global(h2) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .prose-jornal :global(h3) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 1.75rem 0 0.5rem;
  }
  .prose-jornal :global(p) {
    margin: 1rem 0;
    line-height: 1.7;
    color: rgb(5 46 22 / 0.85);
  }
  .prose-jornal :global(ul) {
    margin: 1rem 0;
    padding-left: 1.25rem;
    list-style: disc;
    line-height: 1.7;
  }
  .prose-jornal :global(ol) {
    margin: 1rem 0;
    padding-left: 1.25rem;
    list-style: decimal;
    line-height: 1.7;
  }
  .prose-jornal :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 3px solid var(--color-verde-700);
    padding-left: 1rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
  }
  .prose-jornal :global(a) {
    color: var(--color-verde-900);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-jornal :global(hr) {
    margin: 2rem 0;
    border-color: rgb(5 46 22 / 0.15);
  }
  .prose-jornal :global(img) {
    width: 100%;
    border: 1px solid rgb(5 46 22 / 0.15);
    margin: 1.5rem 0 0;
  }
  .prose-jornal :global(p:has(img)) {
    line-height: 0;
  }
</style>
